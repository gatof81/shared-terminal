#!/usr/bin/env node
// st — the agent's side of the Shared Terminal message API (same API the person
// uses from the web). The sender is the token (ST_TOKEN), never an argument.
//   st send @agent [--work <id>] "text"   st send @agent [--work <id>] -f file.md
//   st work new @agent <id> [--base <ref>]   st work list   st work close|clean <id>
//   st port check <port>   st agents   st list   st get <id>
//   st task goal|new|list|show|move|assign|prio|block|unblock|link|done|handoff …   st send --task <id>
import { readdirSync, readFileSync, readlinkSync } from "node:fs";

const [cmd, ...args] = process.argv.slice(2);
const API = `${process.env.ST_URL}/api/acp`;
const headers = { authorization: `Bearer ${process.env.ST_TOKEN ?? ""}`, "content-type": "application/json" };

// The backend's refusals, said in a line: the code's meaning and the details it sent.
const REASONS = {
	"unknown-recipient": "no hay un agente con ese nombre",
	"work-not-found": "ese trabajo no existe (crealo con st work new)",
	"work-not-yours": "ese trabajo es de otro agente",
	"work-not-active": "ese trabajo ya no está activo",
	"work-other-project": "el trabajo o el agente es de otro proyecto",
	"work-exists": "ese id de trabajo ya existe",
	"work-path-exists": "ya hay algo de ese id en el workspace del agente",
	"work-incomplete": "el trabajo quedó a medio crear",
	"context-needs-slots": "el agente corre un solo mensaje a la vez: un trabajo necesita maxConcurrency ≥ 2",
	"session-not-running": "la sesión del agente no está corriendo",
	"low-disk": "poco espacio libre en el workspace del agente",
	"not-a-repo": "el workspace del agente no es un repositorio git",
	"bad-work-id": "id de trabajo inválido (minúsculas, dígitos y guiones, hasta 40)",
	"bad-base": "ref base inválida o inexistente",
	"execution-ended": "el mensaje para el que corre este proceso ya terminó: no se envió nada",
	"work-busy": "el trabajo tiene mensajes pendientes o en curso",
	"work-not-closed": "primero cerralo (st work close)",
	"cleanup-pending": "no se limpió: quedó pendiente",
	"no-free-ports": "el agente no tiene bloques de puertos libres: limpiá trabajos viejos",
	"context-removed": "el campo context ya no existe: usá --work",
	"task-not-found": "no existe esa tarea en tu proyecto",
	"task-other-project": "la tarea es de otro proyecto que el destinatario",
	stale: "la tarea cambió desde que la leíste: mirá su estado actual (st task show) y decidí de nuevo",
	"not-allowed": "tu rol en la tarea no permite ese cambio",
	"not-coordinator": "solo el coordinador del objetivo (o la persona) crea hijas",
	"self-approval": "el responsable de una tarea no la aprueba: la aprueba su reviewer, el coordinador o la persona",
	"one-level": "una tarea hija no puede tener hijas: colgala del objetivo",
	"no-project": "no estás en un proyecto: no hay tareas",
	"not-in-project": "ese agente no es de este proyecto",
	"not-a-root": "solo un objetivo (o tarea suelta) tiene coordinador",
	"computed-by-backend": "el origen y el coordinador de un objetivo los fija el backend",
	"question-not-found": "no hay una pregunta tuya respondida en este mensaje (o con ese id)",
	"question-not-accepted": "la persona no respondió esa pregunta (la declinó, la canceló o sigue abierta)",
	"question-other-request": "esa pregunta es de otra solicitud que la de este objetivo",
};

async function call(method, path, body) {
	const res = await fetch(API + path, { method, headers, body: body && JSON.stringify(body) });
	const text = await res.text();
	if (!res.ok) {
		let e = null;
		try {
			e = JSON.parse(text);
		} catch {}
		if (!e?.error) console.error(`st: ${res.status} ${text}`);
		else {
			const { error, task: current, ...detail } = e;
			const extra = Object.entries(detail)
				.map(([k, v]) => `${k}: ${typeof v === "string" ? v : JSON.stringify(v)}`)
				.join("; ");
			console.error(`st: ${REASONS[error] ?? error} (${error}${extra ? `; ${extra}` : ""})`);
			// A stale write answers with the task as it is now.
			if (current && typeof current === "object") console.error(`  ahora: ${taskLine(current)}`);
		}
		process.exit(1);
	}
	return text ? JSON.parse(text) : null;
}

// `--name value` anywhere among the arguments; the rest in order.
function option(list, name) {
	const i = list.indexOf(name);
	if (i < 0) return [null, list];
	if (!list[i + 1]) usage();
	return [list[i + 1], [...list.slice(0, i), ...list.slice(i + 2)]];
}
function usage() {
	console.error(
		'uso: st send @agente [--work <id>] [--task <id>] "texto" | st send @agente [--work <id>] [--task <id>] -f archivo | st work new @agente <id> [--base <ref>] | st work list | st work close|clean <id> | st port check <puerto> | st agents | st list | st get <id> | st task goal|new|list|show|move|assign|prio|block|unblock|link|done|handoff … (st task para el detalle)',
	);
	process.exit(2);
}
const workLine = (w) =>
	`${w.id} · @${w.agent} · ${w.state} · rama ${w.branch} · puertos ${w.portBase}–${w.portBase + 99}${w.note ? ` · ${w.note}` : ""}`;

if (cmd === "send") {
	const [work, rest0] = option(args, "--work");
	const [task, rest] = option(rest0, "--task");
	if (rest.length < 2) usage();
	const body = rest[1] === "-f" ? readFileSync(rest[2], "utf8") : rest.slice(1).join(" ");
	const m = await call("POST", "/messages", {
		to: rest[0],
		body,
		...(work ? { work } : {}),
		...(task ? { task: Number(task) } : {}),
	});
	console.log(
		`mensaje #${m.id} para @${m.to_id}${m.context ? ` en el trabajo ${m.context}` : ""}: ${m.state} (persistido${m.project_id ? ", en el proyecto" : ", directo"})`,
	);
} else if (cmd === "work" && args[0] === "new") {
	const [base, rest] = option(args.slice(1), "--base");
	if (rest.length !== 2) usage();
	const w = await call("POST", "/works", { agent: rest[0], id: rest[1], ...(base ? { base } : {}) });
	console.log(`trabajo ${workLine(w)} · base ${w.base ? `${w.base} @ ` : ""}${w.baseSha}`);
} else if (cmd === "work" && args[0] === "list") {
	const all = await call("GET", "/works");
	if (!all.length) console.log("no hay trabajos");
	for (const w of all) console.log(workLine(w));
} else if (cmd === "work" && (args[0] === "close" || args[0] === "clean") && args[1]) {
	const w = await call("POST", `/works/${encodeURIComponent(args[1])}/${args[0]}`);
	console.log(`trabajo ${workLine(w)}${args[0] === "clean" ? " · worktree retirado; la rama queda" : ""}`);
} else if (cmd === "port" && args[0] === "check" && /^\d{1,5}$/.test(args[1] ?? "")) {
	process.exit(portCheck(Number(args[1])));
} else if (cmd === "agents") {
	const me = process.env.ST_AGENT;
	const all = await call("GET", "/agents");
	const mine = all.find((a) => a.name === me)?.projectId ?? null;
	for (const a of all)
		console.log(
			`@${a.name}${a.name === me ? " (vos)" : ""}${mine && a.projectId === mine ? " · mismo proyecto" : ""}${a.skills ? ` · skills ${a.skills.hash ?? "-"}${a.skills.names.length ? ` (${a.skills.names.join(", ")})` : ""}${a.skills.error ? ` · ${a.skills.error}` : ""}` : ""}`,
		);
} else if (cmd === "list") {
	for (const m of await call("GET", "/messages"))
		console.log(`#${m.id} ${m.kind} @${m.from_id} -> @${m.to_id} ${m.state}${m.reply_to ? ` (re #${m.reply_to})` : ""} | ${m.body.replace(/\s+/g, " ").slice(0, 70)}`);
} else if (cmd === "get" && args[0]) {
	console.log(JSON.stringify(await call("GET", `/messages/${args[0]}`), null, 2));
} else if (cmd === "task") {
	await task(args);
} else usage();

// ── st task ───────────────────────────────────────────────────────────────
// Tasks of the caller's project (the backend decides who may change what).
// Every change names the version it was decided on: `--version N` (what
// `st task show` printed); without it, the version read right before.
function taskUsage() {
	console.error(`uso:
  st task goal "título" [-d "descripción"]          el objetivo de la solicitud de la persona que estás atendiendo (uno por solicitud)
  st task new "título" [--parent <id>] [--assign @a] [--review @b] [--prio low|normal|high] [-d "…"]
  st task list                                      tablero del proyecto: abiertas y terminadas recientes
  st task show <id>
  st task move <id> todo|doing|review               (el responsable)
  st task assign <id> @agente [--review @b]         (el coordinador)
  st task prio <id> low|normal|high                 (el coordinador)
  st task block <id> "motivo" | st task unblock <id> (el responsable)
  st task link <id> work|pr|dep|external <ref>
  st task done <id>                                 (el reviewer o el coordinador; nunca el responsable)
  st task handoff <id> @agente                      (el coordinador pasa el objetivo)
  st task approve <id> [--question <id>]            (el coordinador declara el alcance aprobado, después de que la persona respondió su pregunta; queda su respuesta)
  cualquier cambio acepta --version N`);
	process.exit(2);
}
// A function (hoisted): the commands above run before this line is reached.
function taskLine(t) {
	return `#${t.id}${t.parentId ? ` (de #${t.parentId})` : ""} [${t.status}${t.blockedReason ? ", bloqueada" : ""}] ${t.priority !== "normal" ? `${t.priority} · ` : ""}${t.title}` +
	`${t.assignee ? ` · @${t.assignee}` : ""}${t.reviewer ? ` · revisa @${t.reviewer}` : ""}${t.coordinator ? ` · coordina @${t.coordinator}` : ""} · v${t.version}`;
}
async function task(list) {
	const [sub, ...rest0] = list;
	const [ver, rest1] = option(rest0, "--version");
	const id = rest1[0];
	const versionOf = async () => (ver !== null ? Number(ver) : (await call("GET", `/tasks/${id}`)).task.version);
	const change = async (fields) => {
		if (!id) taskUsage();
		const t = await call("PATCH", `/tasks/${encodeURIComponent(id)}`, { version: await versionOf(), ...fields });
		console.log(taskLine(t));
	};
	const name = (v) => (v ? v.replace(/^@/, "") : taskUsage());
	if (sub === "goal" || sub === "new") {
		const [d, r1] = option(rest1, "-d");
		const [parent, r2] = option(r1, "--parent");
		const [assign, r3] = option(r2, "--assign");
		const [review, r4] = option(r3, "--review");
		const [prio, r5] = option(r4, "--prio");
		if (r5.length < 1) taskUsage();
		const t = await call("POST", "/tasks", {
			title: r5.join(" "),
			...(sub === "goal" ? { goal: true } : {}),
			...(d ? { description: d } : {}),
			...(parent ? { parentId: Number(parent) } : {}),
			...(assign ? { assignee: name(assign) } : {}),
			...(review ? { reviewer: name(review) } : {}),
			...(prio ? { priority: prio } : {}),
		});
		console.log(
			t.existing
				? `ya existe el objetivo de esta solicitud: ${taskLine(t)} — coordina @${t.coordinator ?? "la persona"}; no se creó nada`
				: `creada ${taskLine(t)}`,
		);
	} else if (sub === "list") {
		const b = await call("GET", "/tasks");
		if (!b.open.length && !b.done.length) console.log("no hay tareas en el proyecto");
		for (const t of b.open) console.log(taskLine(t));
		if (b.nextOpen) console.log(`… hay más abiertas`);
		if (b.done.length) console.log("— terminadas recientes —");
		for (const t of b.done) console.log(taskLine(t));
	} else if (sub === "show" && id) {
		const s = await call("GET", `/tasks/${encodeURIComponent(id)}`);
		console.log(taskLine(s.task));
		if (s.parent) console.log(`  objetivo: ${taskLine(s.parent)}`);
		if (s.task.blockedReason) console.log(`  bloqueada: ${s.task.blockedReason}`);
		if (s.task.description) console.log(`  ${s.task.description.replace(/\n/g, "\n  ")}`);
		for (const l of s.task.links ?? []) console.log(`  enlace ${l.kind}: ${l.ref}`);
		for (const c of s.children) console.log(`  hija ${taskLine(c)}`);
		for (const e of s.events.slice(-10)) console.log(`  ${e.at} @${e.actor} ${e.kind} ${e.data ? JSON.stringify(e.data) : ""}`);
	} else if (sub === "move" && rest1[1]) await change({ status: rest1[1] });
	else if (sub === "done") await change({ status: "done" });
	else if (sub === "assign" && rest1[1]) {
		const [review, r] = option(rest1, "--review");
		await change({ assignee: name(r[1]), ...(review ? { reviewer: name(review) } : {}) });
	} else if (sub === "prio" && rest1[1]) await change({ priority: rest1[1] });
	else if (sub === "block" && rest1[1]) await change({ blockedReason: rest1.slice(1).join(" ") });
	else if (sub === "unblock") await change({ blockedReason: null });
	else if (sub === "handoff" && rest1[1]) await change({ coordinator: name(rest1[1]) });
	else if ((sub === "approve" || sub === "scope-approved") && id) {
		// `approve <id> --question <qid>` (what the coordinar skill says); without it, the
		// coordinator's own answered question on the message it is running.
		const [qid, r1] = option(rest1, "--question");
		const q = qid ?? r1[1];
		const r = await call("POST", `/tasks/${encodeURIComponent(id)}/scope-approved`, {
			version: await versionOf(),
			...(q ? { questionId: Number(q) } : {}),
		});
		console.log(`${r.recorded ? "registrado" : "ya estaba registrado"}: alcance aprobado del objetivo #${id}${r.question ? ` (pregunta #${r.question})` : ""}`);
	}
	else if (sub === "link" && rest1[1] && rest1[2]) {
		const t = await call("POST", `/tasks/${encodeURIComponent(id)}/links`, {
			version: await versionOf(),
			kind: rest1[1],
			ref: rest1.slice(2).join(" "),
		});
		console.log(taskLine(t));
	} else taskUsage();
}

// ── st port check ─────────────────────────────────────────────────────────
// Who listens on a TCP port in this container, and whether it is the caller's:
// a process whose environment carries the caller's ST_WORK or whose cwd is in
// the caller's worktree (default context: cwd in the workspace, outside
// .st/ctx/, and no ST_WORK). From /proc only (no ss, no dependency): the
// listening socket's inode in /proc/net/tcp{,6}, then the process holding it.
// Exit 0 = yours; 1 = someone else's; 2 = nobody listens; 3 = cannot tell.
function portCheck(port) {
	const ws = process.env.AGENT_CWD ?? "/home/developer/workspace";
	const mine = process.env.ST_WORK || null;
	const inodes = new Set();
	for (const f of ["/proc/net/tcp", "/proc/net/tcp6"]) {
		let lines = [];
		try {
			lines = readFileSync(f, "utf8").trim().split("\n").slice(1);
		} catch {}
		for (const l of lines) {
			const c = l.trim().split(/\s+/);
			if (c[3] === "0A" && Number.parseInt(c[1].split(":")[1], 16) === port) inodes.add(c[9]);
		}
	}
	if (!inodes.size) {
		console.log(`nadie escucha en el puerto ${port}`);
		return 2;
	}
	const holders = [];
	for (const pid of readdirSync("/proc").filter((d) => /^\d+$/.test(d))) {
		let fds = [];
		try {
			fds = readdirSync(`/proc/${pid}/fd`);
		} catch {
			continue;
		}
		for (const fd of fds) {
			let link = "";
			try {
				link = readlinkSync(`/proc/${pid}/fd/${fd}`);
			} catch {}
			const m = /^socket:\[(\d+)\]$/.exec(link);
			if (m && inodes.has(m[1])) {
				holders.push(pid);
				break;
			}
		}
	}
	if (!holders.length) {
		console.log(`el puerto ${port} está en uso, pero no se puede ver qué proceso escucha: no lo des por tuyo`);
		return 3;
	}
	const who = holders.map((pid) => {
		let cwd = "";
		let work = null;
		let cmd = "";
		try {
			cwd = readlinkSync(`/proc/${pid}/cwd`);
			work = readFileSync(`/proc/${pid}/environ`, "utf8").split("\0").find((e) => e.startsWith("ST_WORK="))?.slice(8) || null;
			cmd = readFileSync(`/proc/${pid}/cmdline`, "utf8").split("\0").join(" ").trim().slice(0, 80);
		} catch {
			return { pid, readable: false };
		}
		const inDir = (d) => cwd === d || cwd.startsWith(`${d}/`);
		const own = mine ? work === mine || inDir(`${ws}/.st/ctx/${mine}`) : !work && inDir(ws) && !inDir(`${ws}/.st/ctx`);
		const owner = work ? `del trabajo «${work}»` : inDir(`${ws}/.st/ctx`) ? `de ${cwd}` : inDir(ws) ? "del contexto por defecto" : `con cwd ${cwd}`;
		return { pid, readable: true, own, owner, cmd };
	});
	const bad = who.find((w) => !w.readable);
	if (bad) {
		console.log(`el puerto ${port} lo escucha el proceso ${bad.pid}, que no se puede leer: no lo des por tuyo`);
		return 3;
	}
	const other = who.find((w) => !w.own);
	if (other) {
		console.log(`el puerto ${port} NO es tuyo: lo escucha el proceso ${other.pid} (${other.cmd}) ${other.owner}`);
		return 1;
	}
	console.log(`el puerto ${port} es tuyo: lo escucha el proceso ${who.map((w) => `${w.pid} (${w.cmd})`).join(", ")}`);
	return 0;
}
