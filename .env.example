# ── Shared Terminal — Environment Variables ──────────────────────────────────
#
# This file is read by Docker Compose (it auto-loads `.env` from the compose
# project root), NOT by the Node backend directly — `tsx watch src/index.ts`
# has no dotenv loader, so in bare-dev workflows you need to export the vars
# yourself (or use direnv / a process manager).
#
# Compose then forwards values to the backend container ONLY for keys
# explicitly listed under `services.app.environment` in `docker-compose.yml`.
# Adding a new tunable here without also wiring it through the compose
# environment list means the backend silently runs without it. Both spots
# must be touched together.

# Server port
PORT=3001

# JWT secret — REQUIRED. The compose file refuses to start if this is
# unset, and the backend refuses to start if NODE_ENV=production and
# the value is still the "change-me-in-production" placeholder. Use a
# long random string (e.g. `openssl rand -base64 48`).
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Secrets encryption key — REQUIRED (#186). Used to AES-256-GCM
# encrypt `secret`-typed env-var entries before they land in D1, so
# a D1 dump never contains plaintext API keys / DB URLs / tokens.
# Must decode to exactly 32 bytes. Generate with:
#   openssl rand -base64 32
# Backend refuses to start if this is unset / malformed.
# WARNING: changing this key strands every existing secret entry —
# there's no rotation tooling in v1. See docs/SECRETS_ENCRYPTION_KEY.md
# for backup obligations and loss-impact recovery.
SECRETS_ENCRYPTION_KEY=change-me-in-production-base64-32-bytes

# CORS — comma-separated origins (your Cloudflare Pages URL)
# e.g. https://shared-terminal.pages.dev,http://localhost:5173
CORS_ORIGINS=*

# Trust proxy for req.ip — set to the number of known hops in front of
# the backend. For a Cloudflare Tunnel deployment set this to 1; for
# direct/local dev leave it at 0 (the docker-compose default). Load-
# bearing for /auth rate limiting: without it, every request shares
# the tunnel's IP and per-IP buckets collapse. Do NOT use "true" —
# it makes Express take the leftmost (attacker-controlled)
# X-Forwarded-For entry, defeating per-IP rate limiting entirely.
# TRUST_PROXY=1

# Auth rate-limit tuning. Defaults are defined in backend/src/rateLimit.ts
# (login 10/15min per IP + 10 failed/15min per username; register 5/1h).
# The per-username lockout is strict — a known username can be kept
# locked by any attacker spending 10 bad attempts per 15-minute window.
# If your username is publicly known and you want a narrower DoS window,
# edit DEFAULT_RATE_LIMIT_CONFIG to shrink usernameWindowMs (e.g. 5 min).

# Active-session quota per user. Caps the number of concurrently running /
# stopped sessions a single account can own. Bounds blast radius if an
# account is compromised. Terminated sessions don't count. Default 20.
# MAX_ACTIVE_SESSIONS_PER_USER=20

# Per-user TOTAL resource budgets (#202): the sum of all of one user's
# RUNNING sessions' effective CPU/RAM allocations may not exceed these.
# Checked at session-create time only (existing sessions are never
# affected retroactively). Unset = unlimited (pre-#202 behaviour).
# Admins can override per user via PATCH /api/admin/users/:id/quotas.
# Units: USER_MAX_TOTAL_CPU in cores (decimals ok), USER_MAX_TOTAL_MEM in MiB.
# USER_MAX_TOTAL_CPU=8
# USER_MAX_TOTAL_MEM=16384

# ── Invite-only registration ─────────────────────────────────────────────────
# Registration after the first (bootstrap) account requires an invite code
# minted by an existing user. Codes are stored in the D1 invite_codes table
# in PLAINTEXT — they're single-use and short-lived, but anyone with D1
# read access (a backup leak, an admin token compromise) sees every unused
# code. Rotate them via the Invites modal if you suspect exposure.
#
# How long an unredeemed invite stays valid (decimal days). 1-minute floor
# is enforced internally to prevent burst-cycle quota bypass. Default 30.
# INVITE_EXPIRY_DAYS=30

# ── Cloudflare D1 Database ───────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
D1_DATABASE_ID=your-d1-database-id

# ── Docker ───────────────────────────────────────────────────────────────────
# Session container image name
SESSION_IMAGE=shared-terminal-session

# Image pins (backend/src/imagePins.ts): every image a session container uses
# is kept by a tag <repo>:<image id>, because a rebuild of SESSION_IMAGE on
# the containerd image store deletes the old image even under running
# containers. "off" disables pinning (kill switch; the images:pins gate is then
# NO-GO and every create logs that its image is UNPROTECTED); default on.
# SESSION_IMAGE_PINS=on
# SESSION_IMAGE_PIN_REPO=shared-terminal-session-pin
# Exact (containerId, imageId) pairs of images lost BEFORE pins existed
# (root-owned, not group/world-writable; see DEPLOYMENT.md "Session image pins").
# SESSION_IMAGE_PIN_EXCEPTIONS=/var/shared-terminal/workspaces/.st-image-pins/exceptions.json

# Where session workspace volumes are stored on the host
WORKSPACE_ROOT=/var/shared-terminal/workspaces

# ── Conversation capture (Phase 3, docs/CONVERSATION.md) ─────────────────────
# Master switch for the hook-based conversation receiver. Unset/false
# (default): the ingest endpoint answers 204 and discards, no session gets a
# hooks file or an ingest token, no extra bind mount — behaviour-neutral.
# `true` turns the receiver on; capture is still per-session opt-in
# (sessions.conversation_requested, set by the admin
# `PATCH /api/admin/sessions/:id/conversation` or the allowlist below).
# Emergency off without a rebuild: `npm run conversation:disable -- <sid>|--all`.
# CONVERSATION_ENABLED=false
#
# Comma-separated user ids whose NEW sessions are born with capture
# requested (existing sessions are never touched). Requested is not
# effective: the flag above, no revocation and a relay image still apply.
# CONVERSATION_ALLOW_USERS=
#
# CONVERSATION.md §3.1.1 (v1.8.6) — require each hook-ingest request to come
# from the session's CURRENT container on SESSIONS_NETWORK (TCP peer vs the
# container inspected by id), so a leaked ST_INGEST_TOKEN is useless from the
# Tunnel, loopback or another container. Unset/false (default): no change, no
# Docker inspection. `observe` runs the check on real requests and only counts
# the outcome (never refuses) — the activation gate in docs/DEPLOYMENT.md
# ("Ingest network origin"); `true` enforces it, and only after that gate
# passes. Any other value is treated as off.
# INGEST_REQUIRE_SESSION_ORIGIN=false

# ── Composer (3.2, docs/CONVERSATION.md §8) ───────────────────────────────────
# Off by default: the POST …/messages route is not mounted and canSendInput
# is false everywhere. Turn on only after the backend runs with the fix of
# #444 and capture is effective on the session.
# CONVERSATION_COMPOSER_ENABLED=false
# Claude Code versions the §8.2 validation was repeated with (comma-separated).
# A conversation whose CLI version the policy does not admit (not listed and
# below the minimum, or denied) gets 409 cli-unvalidated.
# 2.1.314, 2.1.316 and 2.1.322 are covered by the Session Image workflow's
# `cli-variants` job (coverage, not a gate). With the open minimum below, the
# default list already admits the pre-3.0d sessions (2.1.316) and session A
# (2.1.322). Default when unset: 2.1.314.
# COMPOSER_CLI_VERSIONS=2.1.314
# OPEN policy, ON BY DEFAULT (owner, 2026-11-10): also admit ANY later stable
# release (patch, minor or major), with no ceiling. Unset = the lowest version
# of the list above; set = one of those versions; `off` = the exact list only
# (the previous behaviour). The composer judges the version of the pane's
# live Claude process, never PATH's, and keeps every dynamic check (identity,
# foreground, empty input, visible consumption of each paste, the ack).
# RISK (accepted by the owner): a release nobody revalidated can change the
# CLI's terminal behaviour and misdeliver a send in ways those checks cannot
# see (CONVERSATION.md §8.1.9). A send is never retried; the Terminal stays.
# COMPOSER_CLI_MIN_VERSION=
# Exact versions refused whatever the list or the minimum say (a broken
# release; the daily "Composer CLI canary" workflow tells you which).
# COMPOSER_CLI_DENY=

# ── Recreation: the workspace CLI (docs/CONVERSATION.md §2.7.5) ───────────────
# A recreated container runs the workspace's own Claude Code with
# /etc/st-control mounted. Since 2026-11-10 (owner) any plain stable release
# at or above the floor passes, validated or not; an unreadable version or a
# pre-release still blocks (`control-marker-incompatible`). Unset = 2.1.308
# (the lowest validated); set = a validated version (2.1.308, 2.1.314,
# 2.1.316, 2.1.322); `off` = the validated versions only (the previous behaviour).
# RECREATE_CLI_MIN_VERSION=
# Exact versions that block a recreation whatever the floor says.
# RECREATE_CLI_DENY=
# EXPERIMENTAL (docs/CONVERSATION.md §8.1.12, v1.9 proposal, NOT approved for
# production): a Chat send to a CLI background session (`claude --bg` / the
# daemon; no tmux pane) is delivered through the daemon's `reply` op with
# `nextTurn: true`. Needs the composer above. Off unless true/1.
# CONVERSATION_COMPOSER_BG_ENABLED=false
# Exact list of CLI versions whose bg-reply smoke is green; no open minimum.
# EMPTY by default: with the flag on and no list, every background send is
# refused 409 cli-unvalidated.
# COMPOSER_BG_CLI_VERSIONS=
# Session ids (comma-separated) the experimental transport applies to. EMPTY ⇒
# no session at all, even with the flag on (the canary lists ONE disposable
# session). With the flag off a malformed value only warns.
# COMPOSER_BG_SESSIONS=

# ── Legacy session activation (docs/CONVERSATION.md §2.7.7) ───────────────────
# A carry-over recreation writes the old container's layer (4–12 GB) into the
# new one on Docker's data-root filesystem, which the backend container cannot
# see. Name a path INSIDE the backend container that lives on that same
# filesystem: the workspace root when `stat -c %d` on the host gives the same
# device for `docker info --format '{{.DockerRootDir}}'` and WORKSPACE_ROOT
# (VM100: one /dev/sda1), otherwise a read-only bind of a probe directory
# created beside the data root. Unset ⇒ every carry-over is refused with
# `disk-space-unknown`; the strict recreation is unaffected.
# RECREATE_DOCKER_FS_PATH=/var/shared-terminal/workspaces

# Shared user-defined Docker network that BOTH the backend `app` service and
# every spawned session container join. The port dispatcher reaches a session
# container directly by name over this network (Docker's embedded DNS), so
# exposing/closing a port is a live metadata edit with no container recreate.
# Create it once before `docker compose up`:  docker network create sessions-net
# Must match the `networks:` entry in docker-compose.yml. Default: sessions-net
SESSIONS_NETWORK=sessions-net

# Optional: route Docker API calls through a socket proxy (e.g. tecnativa/
# docker-socket-proxy) instead of the default /var/run/docker.sock. With this
# set, DockerManager passes no explicit connection options to dockerode and
# docker-modem reads the URL from the environment; with it unset the backend
# falls back to the canonical Unix socket. If both are configured at once,
# DOCKER_HOST takes precedence — when it's set DockerManager passes no
# socketPath at all, so a /var/run/docker.sock bind-mount is silently
# unused. Drop the bind-mount in proxy deployments so an RCE has nothing
# to fall back to. See docs/SECURITY.md "Optional: docker-socket-proxy"
# for the full overlay snippet.
# DOCKER_HOST=tcp://docker-socket-proxy:2375

# Per-session disk quota for files uploaded via POST /api/sessions/:id/files
# (the + → Attach file flow). Counts only files inside the session's
# uploads/ directory; files the container writes elsewhere in /home/developer/
# workspace are not counted. Default 1 GB (1073741824). Tune down on
# resource-constrained hosts.
#
# AGGREGATE EXPOSURE: this cap is per session, not per user. Sessions
# survive soft-delete, so a single user holding 20 sessions (the default
# per-user cap) can accumulate 20 × UPLOAD_QUOTA_BYTES on disk before
# anything caps them. On a constrained host, size this so
# (per-user-session-cap × UPLOAD_QUOTA_BYTES) fits comfortably in the
# disk slice you're willing to allocate per user.
# UPLOAD_QUOTA_BYTES=1073741824

# ── Per-session resource caps (#200) ─────────────────────────────────────────
# Operator-tunable upper bounds on per-session CPU and memory. Defaults
# are the v1 ceilings (8 cores / 16 GiB). Both env vars can only LOWER
# the cap — values above the ceiling are clamped (and warned) at boot,
# so a deployment that needs MORE than the v1 limits requires a code
# change to raise the ceilings themselves. The per-session floor is
# 0.25 cores / 256 MiB; setting a cap below the floor falls back to the
# default with a warn (every session-create would otherwise 400).
#
# Units: MAX_SESSION_CPU is in cores (decimal accepted: 4, 4.5, 0.25).
#        MAX_SESSION_MEM is in MiB (integer: 4096 = 4 GiB).
#
# Effect: rejects POST /api/sessions whose body.config.cpuLimit /
# memLimit exceed the cap with a 400 naming the env var, AND clamps
# the spawn defaults (2c / 2 GiB) when the operator caps below them
# so a session created without explicit limits still respects the
# cap (otherwise the docker run command would silently spawn above
# the cap).
#
# Already-running containers are NOT affected. Docker cgroup limits
# are written at `docker run` — a lowered cap only gates future
# create requests, not the containers spawned before the change.
#
# Parsed at startup. Malformed / non-positive / non-finite values
# fall back to the default with a warn so a typo doesn't gate the
# server on a non-critical config issue.
# MAX_SESSION_CPU=8
# MAX_SESSION_MEM=16384

# ── Port exposure dispatcher (#190) ──────────────────────────────────────────
# Base domain for the per-session-port reverse proxy. Hosts of the form
# `p<container>-<sessionId>.<PORT_PROXY_BASE_DOMAIN>` are diverted from
# the API/WS routes into the dispatcher (see portDispatcher.ts), looked
# up against `sessions_port_mappings`, and reverse-proxied to the
# kernel-assigned `127.0.0.1:<host_port>`. `public: false` ports require
# the same `st_token` cookie as the rest of the app; `public: true`
# skip auth entirely (webhook / OAuth callback shape).
#
# Unset → dispatcher is a no-op middleware; port-exposure features are
# silently disabled. This is intentional so dev/local without a Tunnel
# keeps working. Logged once at startup.
#
# Cloudflare Tunnel ingress should send `*.<PORT_PROXY_BASE_DOMAIN>`
# to the backend.
# PORT_PROXY_BASE_DOMAIN=tunnel.example.com

# REQUIRED when PORT_PROXY_BASE_DOMAIN is set AND the API hostname differs
# from the dispatcher's per-session subdomains: the JWT auth cookie is
# host-only by default (RFC 6265 §5.3), so without a shared parent the
# browser will never attach the cookie to a `p<port>-<sid>.tunnel.…` URL
# and `public: false` ports return 401 to the authenticated session
# owner. Set this to the parent domain shared by API and the dispatcher
# base — e.g. `terminal.example.com` if your API is at
# `api.terminal.example.com` and PORT_PROXY_BASE_DOMAIN is
# `tunnel.terminal.example.com`. Leading dot is accepted (legacy form)
# and stripped on persist. Same-hostname deployments and local dev
# don't need this.
#
# Security note: a wider Domain ships the cookie to every subdomain,
# so the parent must be one you fully control. Avoid pasting in a
# public-suffix-style domain (e.g. `.pages.dev`).
#
# Use the SHARED SUBDOMAIN PARENT, not the apex. If the API is at
# `api.terminal.example.com` and the dispatcher is at
# `*.tunnel.terminal.example.com`, the right value is
# `terminal.example.com` — NOT `example.com`. The validation regex
# accepts both because they're both syntactically valid domains, but
# setting the apex ships the JWT cookie to every unrelated subdomain
# of `example.com`, including any marketing site, redirect catcher,
# or experiment app you may run. Validation can't tell those apart;
# operator discretion required.
# COOKIE_DOMAIN=terminal.example.com

# ── Web Push (#355) ──────────────────────────────────────────────────────────
# VAPID keypair for browser push notifications ("Claude finished / needs
# input"). Generate a pair once with:
#     node -e "console.log(require('web-push').generateVAPIDKeys())"
# All three must be set for push to be enabled — any missing → push is
# silently disabled (the backend warns once at boot). The public key is
# served to the frontend via GET /api/push/vapid-key, so NO frontend
# build-time env var is needed. VAPID_SUBJECT must be a mailto: or https: URL.
# Rotating these invalidates all existing browser subscriptions (no data loss).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
#
# Push-service hosts a subscription endpoint may name (#566). Unset = the
# browsers' services: fcm.googleapis.com, *.push.services.mozilla.com,
# web.push.apple.com, *.notify.windows.com. A comma-separated list REPLACES
# that default (host names or *.suffix; never an IP). A malformed entry
# disables push with a warning. Endpoints are always https on port 443, with
# no user:password and no IP literal — the backend POSTs to them.
# PUSH_ENDPOINT_HOSTS=

# ── Frontend (Cloudflare Pages) ──────────────────────────────────────────────
# Set this as an env var in Cloudflare Pages dashboard:
# VITE_API_URL=https://api.terminal.yourdomain.com

# Frontend shell (UI unification, docs/design/ui-unificada.md §8.4).
# v1 = the current layout; v2 = the unified shell (session bar with the
# view tabs on every view, user menu, no mobile drawers). Surfaced on
# GET /api/auth/status as `uiShell`; change + restart the backend to roll
# forward or back, no frontend redeploy. A browser can try the other shell
# with ?ui=v2 (or ?ui=v1) in the address — kept in that browser only.
# UI_SHELL=v1

# Project & agent directory (P3a, docs/PROJECTS.md). Off by default: with it
# unset the /api/projects routes do not exist (404), GET /api/sessions rows
# carry no `binding` and GET /api/auth/status has no `features`. Only `true`
# or `1` turn it on. Its D1 migration (v19, additive) runs at boot WHATEVER
# this says — the flag gates the API, not the schema.
# PROJECT_CHAT_ENABLED=false

# Project conversation (D1, docs/PROJECT_CONVERSATION.md). Off by default: with
# it unset the /api/projects/:pid/conversation/* routes and WS /ws/project/<pid>
# do not exist (404 / not admitted), nothing is written under
# <WORKSPACE_ROOT>/.projects/ and GET /api/auth/status is byte-identical. Only
# `true` or `1` turn it on, and it is EFFECTIVE only when PROJECT_CHAT_ENABLED
# and CONVERSATION_COMPOSER_ENABLED are on too (each send is an ordinary
# Composer send). Needs /usr/bin/flock in the backend image (the single-writer
# lock, §2.1); without the lock the routes answer 503 project-writer-unavailable.
# PROJECT_CONVERSATION_ENABLED=false

# Project artifacts (D2, docs/PROJECT_CONVERSATION.md §6). Off by default: with
# it unset the /api/projects/:pid/conversation/artifacts routes do not exist,
# a message with `artifacts[]` is refused (409 artifacts-off) and no workspace
# file is read or written by the project conversation. Only `true` or `1` turn
# it on, and it is EFFECTIVE only with PROJECT_CONVERSATION_ENABLED effective.
# On: text files (≤ 1 MiB, UTF-8, through the Files denylist) picked from an
# agent's workspace are stored under .projects/<pid>/artifacts/ and copied,
# never overwriting, into the target's ~/workspace/.st-inbox/.
# PROJECT_ARTIFACTS_ENABLED=false

# Backup permissions (#562). `npm run backup` never writes anything readable
# by "others". Unset ⇒ 0700/0600, root only. A numeric group id ⇒ 0750/0640 in
# that group, for an off-host copy (rsync to the NAS) running as a non-root
# user in that group. A NUMERIC id: the container doesn't know host group
# names. Existing backups: `npm run backup:harden` (dry run; `-- --write`).
# BACKUP_GROUP_GID=
