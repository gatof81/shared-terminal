# Copy to config.env ON THE POC VM. Never put credentials or tokens here.

# Production addresses the POC must NOT reach: the Proxmox host and its VMs,
# as single addresses (/32) or narrow ranges. Required. Do not list the whole
# LAN if you reach the POC VM over SSH from that LAN.
PROD_CIDRS="192.0.2.10/32 192.0.2.11/32"
# Addresses and ports used to prove that production is unreachable. Required.
PROD_PROBE_IPS="192.0.2.10"
PROD_PROBE_PORTS="22 443 8006"

# Pinned versions (phase 0). Changing them invalidates the S0 evidence.
CLI_VERSION=2.1.314
BUN_VERSION=1.3.10
NODE_IMAGE=node:22-bookworm-slim
PROXY_BASE_IMAGE=alpine:3.20
FAKECHAT_COMMIT=7994c270e575fa82bc86b3e99363bf8fe55292f7
