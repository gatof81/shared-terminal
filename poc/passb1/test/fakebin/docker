#!/usr/bin/env python3
"""Fake `docker` for test_runner.py: state in $FAKE_DOCKER_STATE (JSON), call log appended.
Implements only what run-b1.sh calls; anything else exits 99 so a new call is noticed.
The container's files live under S["cfs"]; b1.py subcommands write what the real ones would."""
import json, os, shutil, sys, uuid

SP = os.environ["FAKE_DOCKER_STATE"]
S = json.load(open(SP))
a = sys.argv[1:]
S.setdefault("calls", []).append(a)


def save():
    json.dump(S, open(SP, "w"))


def out(s="", code=0):
    save()
    if s:
        print(s)
    sys.exit(code)


def find(ref):
    for c in S.get("containers", []):
        if ref in (c["id"], c["name"]) or c["id"].startswith(ref):
            return c
    return None


def cpath(p):
    return os.path.join(S["cfs"], p.lstrip("/"))


def put(p, obj):
    os.makedirs(os.path.dirname(cpath(p)), exist_ok=True)
    with open(cpath(p), "w") as f:
        json.dump(obj, f)


def size(v):
    return int(v[:-1]) * 1024 ** 3 if v.endswith("g") else int(v)


if a[:1] == ["info"]:
    out(S.get("info", '["name=seccomp,profile=builtin"]'))
if a[:2] == ["image", "inspect"]:
    out(S["image_id"]) if a[2] in (S["image"], S["image_id"]) else out("", 1)
if a[:2] == ["image", "history"]:
    out(S["history"])
if a[:1] == ["ps"]:
    f = a[a.index("--filter") + 1]
    k, _, v = f.partition("=")
    hits = []
    for c in S.get("containers", []):
        if k == "label":
            lk, _, lv = v.partition("=")
            if lk in c["labels"] and (not lv or c["labels"][lk] == lv):
                hits.append(c["id"])
        elif k == "name" and c["name"] == v.strip("^/$"):
            hits.append(c["id"])
    out("\n".join(hits))
if a[:1] == ["run"]:
    args = a[1:]
    get = lambda f: args[args.index(f) + 1]
    labels = dict(args[i + 1].split("=", 1) for i, x in enumerate(args) if x == "--label")
    if S.get("drop_run_label"):
        labels.pop("passb1.run", None)
    mounts = []
    for i, x in enumerate(args):
        if x == "--mount":
            kv = dict(p.split("=", 1) if "=" in p else (p, True) for p in args[i + 1].split(","))
            mounts.append({"Type": kv["type"], "Source": kv["src"], "Destination": kv["dst"], "RW": not kv.get("readonly")})
    hc = {"Memory": size(get("--memory")), "MemorySwap": size(get("--memory-swap")), "NanoCpus": int(float(get("--cpus")) * 1e9),
          "PidsLimit": int(get("--pids-limit")), "CapDrop": [get("--cap-drop")], "CapAdd": None, "SecurityOpt": [get("--security-opt")],
          "Privileged": False, "NetworkMode": get("--network"), "PidMode": "", "IpcMode": "private", "Binds": None, "Devices": [], "VolumesFrom": None}
    hc.update(S.get("override_hostconfig", {}))
    c = {"id": uuid.uuid4().hex * 2, "name": get("--name"), "labels": labels, "user": get("--user"), "hc": hc, "mounts": mounts}
    S.setdefault("containers", []).append(c)
    out(c["id"])
if a[:1] == ["inspect"]:
    if a[1] == "-f":
        c = find(a[3])
        if not c:
            out("", 1)
        fmt = a[2]
        if fmt == "{{.Id}}":
            out(c["id"])
        if fmt == "{{.Name}}":
            out("/" + c["name"])
        if "Labels" in fmt:
            import re as _re
            mk = _re.search(r'Labels \"([^\"]+)\"', fmt)
            out(c["labels"].get(mk.group(1) if mk else "passb1.experiment", ""))
        out("", 99)
    c = find(a[1])
    if not c:
        out("[]", 1)
    out(json.dumps([{"Id": c["id"], "Name": "/" + c["name"], "Config": {"Labels": c["labels"], "User": c["user"]}, "HostConfig": c["hc"], "Mounts": c["mounts"]}]))
if a[:1] == ["exec"]:
    rest = a[1:]
    assert rest[0] == "-u" and rest[1] in ("developer", "0"), rest
    user = rest[1]
    c = find(rest[2])
    if not c:
        out("Error: No such container", 1)
    cmd = rest[3:]
    if c.get("stopped"):
        out("Error response from daemon: container is not running", 1)
    if user == "0":
        S.setdefault("root_execs", []).append(cmd)
        if "install" in " ".join(cmd):
            if S.get("fail_install"):
                out("install: cannot change ownership: Operation not permitted", 1)
            S["installed"] = True
            out("")
        if "sha256sum" in " ".join(cmd):
            out(f"{S.get('hnd_sha', '4487042b4c4f5d88d4568f68ae98aae0b1ffae58864cf57fb868641bc5f84594')}\n0 0 {S.get('hnd_mode', '711')} 298229464 99")
        out("", 99)
    if "passb1-evidence-check" in cmd:
        for d in ("tmp/passb1", "home/developer/b1"):
            for _, _, fs in os.walk(os.path.join(S["cfs"], d)):
                if fs:
                    out("", 1)
        out("")
    if cmd[:2] == ["claude", "--version"] or (len(cmd) > 1 and cmd[1] == "--version"):
        out(f"{S.get('cli_version', '2.1.314')} (Claude Code)")
    if cmd[:2] == ["id", "-u"]:
        out("1000")
    if cmd[:1] == ["mkdir"]:
        for p in cmd[2:]:
            os.makedirs(cpath(p), exist_ok=True)
        out("")
    if cmd[:1] == ["test"]:
        out("", 0 if os.path.exists(cpath(cmd[-1])) else 1)
    if cmd[:3] == ["python3", "-I", "/opt/passb1-kit/b1.py"]:
        sub, rest2 = cmd[3], cmd[4:]
        o = rest2[rest2.index("--out") + 1] if "--out" in rest2 else None
        if sub == "attempt":
            aid = rest2[rest2.index("--id") + 1]
            root = rest2[rest2.index("--root") + 1]
            put(f"{root}/{aid}/result.json", {"id": aid, "markers": []})
            out(json.dumps({"id": aid}))
        if o:
            put(o, S.get("canned", {}).get(sub, {"sub": sub}))
        out("{}")
    if cmd[:2] == ["sh", "-c"]:
        script = cmd[2]
        if "readlink -f" in script:
            out("/home/developer/.npm-global/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe")
        if "command -v claude" in script:
            out("/home/developer/.npm-global/bin/claude")
        if "pgrep" in script:
            out("")
        if "pane_pid" in script:
            if S.get(f"fail_{cmd[4] if len(cmd) > 4 else ''}_start"):
                out("", 9)
            S["pane"] = S.get("pane", 4000) + 1
            out(str(S["pane"]))
        if "update" in script:
            out("1")
        out("")
    out("", 99)
if a[:1] == ["cp"]:
    src, dst = a[1], a[2]
    if ":" in dst and not dst.startswith("/"):  # host -> container
        name, _, path = dst.partition(":")
        if not find(name):
            out("Error: No such container", 1)
        os.makedirs(os.path.dirname(cpath(path)), exist_ok=True)
        shutil.copy(src, cpath(path))
        out("")
    name, _, path = src.partition(":")
    if not find(name):
        out("Error: No such container", 1)
    local = cpath(path)
    if path.endswith("/."):
        base = local[:-2]
        if not os.path.isdir(base):
            out("Error: Could not find the file", 1)
        shutil.copytree(base, dst, dirs_exist_ok=True)
        out("")
    out("Error: Could not find the file", 1)
if a[:1] == ["rm"]:
    S["containers"] = [c for c in S.get("containers", []) if c["id"] != a[-1]]
    out(a[-1])
out("unhandled", 99)
