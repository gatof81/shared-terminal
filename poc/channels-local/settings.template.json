{
  "forceLoginMethod": "claudeai",
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_EXTRA_USAGE_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "permissions": {
    "defaultMode": "default",
    "allow": ["mcp__plugin_fakechat_fakechat__reply"],
    "deny": [
      "Bash", "Read", "Edit", "Write", "NotebookEdit", "Glob", "Grep",
      "WebFetch", "WebSearch", "Agent", "Task",
      "mcp__plugin_fakechat_fakechat__edit_message"
    ]
  },
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "\"__BUN__\" \"__HOOK__\"", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "\"__BUN__\" \"__HOOK__\"", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "\"__BUN__\" \"__HOOK__\"", "timeout": 5 }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "\"__BUN__\" \"__HOOK__\"", "timeout": 5 }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "\"__BUN__\" \"__HOOK__\"", "timeout": 5 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "\"__BUN__\" \"__HOOK__\"", "timeout": 5 }] }]
  }
}
