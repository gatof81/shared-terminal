#!/bin/bash
# st-ops-root — root side of st-ops (ops/st-ops/README.md). Every path is fixed here, never taken from the
# environment (sudo env_reset already drops it) or from the caller. The kit's path above all: what runs as root is
# the kit at this path, at the commit the owner signed.
# shellcheck disable=SC2034 # the ST_OPS_* paths are read by the sourced library
set -euo pipefail
umask 077
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
ST_OPS_ETC=/etc/st-ops
ST_OPS_STATE=/var/lib/st-ops
ST_OPS_LIB=/usr/local/lib/st-ops
ST_OPS_KIT=/root/st-deploy-kit
ST_OPS_LOG_BASE=/root
# shellcheck source-path=SCRIPTDIR source=../lib/st-ops-lib.sh
source "$ST_OPS_LIB/st-ops-lib.sh"
st_ops_main "$@"
