# /etc/st-ops/st-ops.conf — root:root 0644. Read (parsed, never sourced) by st-ops-root.
# Public repository the server fetches by itself, without credentials: provenance never comes from the caller.
REPO_URL=https://github.com/gatof81/shared-terminal.git
# CI is read only from THIS workflow's own push run on main for the target (its check suite): a check-run name is not
# identity, any workflow with `checks: write` can post one. Every job below must be in that run and `success`.
REQUIRED_WORKFLOW=.github/workflows/ci.yml
REQUIRED_CHECKS="Backend (tsc + vitest)|Backend image (clean dist, no host residue)|Frontend (tsc + vite build)|Frontend e2e (Playwright, desktop + mobile)|Ops checks (shellcheck + tests)"
# A request must be approved this many seconds after it was proposed at the latest.
REQUEST_TTL=7200
# Stage 1 = off: only the verbs that need no signature (help, status, propose, request-text, preflight, result,
# cancel). `approve` and `step` refuse until the owner sets `on` (stage 2) AND adds their key to allowed_signers.
SIGNED_VERBS=off
# Only for `status` (which image the backend's `app` service runs). Optional.
COMPOSE_PROJECT=shared-terminal
